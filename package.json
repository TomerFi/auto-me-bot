{
  "name": "auto-me-bot",
  "version": "3.1.3",
  "private": true,
  "type": "module",
  "main": "src/app-runner.js",
  "description": "A Probot app that takes care of your GitHub repos for you",
  "author": {
    "name": "Tomer Figenblat",
    "url": "https://github.com/TomerFi"
  },
  "license": "ISC",
  "homepage": "https://auto-me-bot.figenblat.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/TomerFi/auto-me-bot"
  },
  "bugs": {
    "url": "https://github.com/TomerFi/auto-me-bot/issues"
  },
  "keywords": [
    "probot",
    "github",
    "probot-app"
  ],
  "scripts": {
    "start": "probot run ./src/auto-me-bot.js",
    "lint": "npm run eslint && npm run prettier && npm run ec",
    "test": "c8 npm run tests",
    "tests": "mocha --check-leaks --fail-zero --color --ui tdd --recursive ./tests/",
    "tests:rep": "mocha --check-leaks --fail-zero --ui tdd --recursive --reporter json ./tests/ > unit-tests-result.json",
    "eslint": "eslint src tests",
    "eslint:fix": "eslint --fix src tests",
    "prettier": "echo \"prettier --check .\"",
    "prettier:fix": "echo \"prettier --write .\"",
    "ec": "ec",
    "link-ai-files": "aicfg link agents --to claude-code",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "npm run eslint:fix --",
      "npm run prettier:fix --"
    ],
    "*": [
      "npm run ec --"
    ]
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.0",
    "@commitlint/lint": "^21.0.0",
    "@commitlint/load": "^21.0.0",
    "lodash-es": "^4.17.21",
    "marked": "^18.0.0",
    "probot": "^14.0.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "aicfg": "^0.1.0",
    "c8": "^12.0.0",
    "chai": "^6.0.0",
    "editorconfig-checker": "^6.1.1",
    "eslint": "^10.0.0",
    "eslint-plugin-mocha": "^12.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mocha": "^11.0.1",
    "prettier": "^3.9.6",
    "sinon": "^22.0.0",
    "sinon-chai": "^4.0.0"
  },
  "engines": {
    "node": ">= 22.0.0",
    "npm": ">= 10.0.0"
  },
  "c8": {
    "all": true,
    "check-coverage": true,
    "clean": true,
    "compact": false,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [],
    "reporter": [
      "html",
      "lcov",
      "text"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "tabWidth": 4
  }
}
